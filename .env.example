# Copia este archivo a .env y ajusta los valores antes de levantar el sistema.

# Base de datos
POSTGRES_USER=cms
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=cms
DB_PORT=5433

# Aplicación
WEB_PORT=5050

# Clave de firma de sesiones. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
CMS_SECRET_KEY=

# Usuario inicial del panel. Solo se usa la primera vez, cuando no hay usuarios.
CMS_ADMIN_USER=admin
CMS_ADMIN_PASSWORD=cambia-esta-clave
